{
  "name": "diddy",
  "build": { 
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "remoteEnv": { "SHELL": "/bin/zsh" },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": { "path": "/bin/zsh" }
        }
      }
    }
  },
  "postCreateCommand": "bash /workspaces/dotfiles/.devcontainer/setup.sh"
}