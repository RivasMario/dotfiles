#!/usr/bin/env python3
import json
import subprocess
import sys
import os
import re
import argparse

OLLAMA_URL = "http://100.81.194.15:30068/api/chat"
PROXY = "127.0.0.1:1055"
PLANNER_MODEL = "llama3.2:3b"
EXECUTOR_MODEL = "qwen2.5-coder:7b"

# Network Hardware
PVE_IP = "100.70.69.28"
NAS_IP = "100.81.194.15"

# HARD VRAM LIMITS
MAX_CONTEXT_TOKENS = 4096

# Artifacts
PACKET_FILE = "MISSION_PACKET.md"
LOG_FILE = "MISSION_LOG.md"

# Colors
BLUE = "\033[94m"
GREEN = "\033[92m"
YELLOW = "\033[93m"
RED = "\033[91m"
CYAN = "\033[96m"
BOLD = "\033[1m"
RESET = "\033[0m"

def get_env_context():
    import platform
    return f"OS: {platform.system()} | Host: {platform.node()} | CWD: {os.getcwd()}"

def ask_ollama(model, system, prompt):
    data = json.dumps({
        "model": model,
        "messages": [
            {"role": "system", "content": f"{get_env_context()} {system}"},
            {"role": "user", "content": prompt}
        ],
        "stream": False,
        "keep_alive": 0,
        "options": {"num_ctx": MAX_CONTEXT_TOKENS}
    })
    cmd = ["curl", "-s", "--socks5-hostname", PROXY, "-H", "Content-Type: application/json", "-d", data, OLLAMA_URL]
    result = subprocess.run(cmd, capture_output=True, text=True)
    try:
        return json.loads(result.stdout).get("message", {}).get("content", "")
    except:
        return f"Error: {result.stdout}"

def execute_tool(action_line):
    match = re.match(r'ACTION:\s*(\w+)\s*"(.*)"', action_line, re.IGNORECASE)
    if not match: return "Error: Invalid action format."
    tool, cmd = match.groups()
    print(f"{BOLD}{BLUE}[Operator Executing {tool}]{RESET} {cmd}")
    
    if tool.lower() == "run_local":
        res = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        return (res.stdout + res.stderr).strip()
    elif tool.lower() == "ssh_pve":
        ssh = ["ssh", "-o", f"ProxyCommand=ncat --proxy {PROXY} --proxy-type socks5 %h %p", "-o", "StrictHostKeyChecking=no", f"root@{PVE_IP}", cmd]
        res = subprocess.run(ssh, capture_output=True, text=True)
        return (res.stdout + res.stderr).strip()
    elif tool.lower() == "ssh_truenas":
        ssh = ["sshpass", "-p", "crispypond211", "ssh", "-o", f"ProxyCommand=ncat --proxy {PROXY} --proxy-type socks5 %h %p", "-o", "StrictHostKeyChecking=no", f"nasuser@{NAS_IP}", cmd]
        res = subprocess.run(ssh, capture_output=True, text=True)
        return (res.stdout + res.stderr).strip()
    return "Unknown tool."

def cmd_jipoe(mission):
    print(f"{BOLD}{GREEN}🔍 INITIATING JIPOE (Intelligence Prep of the Operational Environment){RESET}")
    sys_prompt = """You are a JIPOE Analyst. Prepare an Intelligence Packet for the Commanding Officer. 
    1. Define the Operational Environment (Hosts, Paths, Constraints).
    2. Evaluate the Adversary (The problem or mission).
    3. Present TWO Courses of Action (COA):
       - COA 1: Conservative/Safe Approach.
       - COA 2: Direct/Aggressive Approach.
    Output ONLY the markdown packet. Structure it professionally."""
    
    packet = ask_ollama(PLANNER_MODEL, sys_prompt, mission)
    with open(PACKET_FILE, "w") as f:
        f.write(packet)
    print(f"\n{BOLD}JIPOE Packet generated: {PACKET_FILE}{RESET}\n")
    print(packet)
    print(f"\n{BOLD}{YELLOW}CO: Review {PACKET_FILE} and run 'diddy execute --coa X'{RESET}")

def cmd_execute(coa_number):
    if not os.path.exists(PACKET_FILE):
        print(f"{RED}Error: No JIPOE packet found. Run 'diddy jipoe' first.{RESET}")
        return
    
    print(f"{BOLD}{YELLOW}🚀 TACTICAL EXECUTION: COA {coa_number}{RESET}")
    with open(PACKET_FILE, "r") as f:
        packet = f.read()

    history = [{"role": "system", "content": f"You are the Tactical Operator. Execute COA {coa_number} from this JIPOE Packet: {packet}. Use format THOUGHT: reason, ACTION: tool_name \"cmd\". Tools: run_local, ssh_pve, ssh_truenas. Limit 5 steps. End with REPORT: final result."}]
    
    log_content = f"EXECUTION OF COA {coa_number}\n"
    for i in range(5):
        data = json.dumps({"model": EXECUTOR_MODEL, "messages": history, "stream": False, "keep_alive": 0})
        cmd = ["curl", "-s", "--socks5-hostname", PROXY, "-H", "Content-Type: application/json", "-d", data, OLLAMA_URL]
        res = subprocess.run(cmd, capture_output=True, text=True)
        resp = json.loads(res.stdout).get("message", {}).get("content", "")
        
        print(f"\n{CYAN}--- Step {i+1} ---{RESET}\n{resp}")
        log_content += f"\nStep {i+1}:\n{resp}\n"
        
        if "REPORT:" in resp: break
        if "ACTION:" in resp:
            lines = resp.split("\n")
            action_line = [l for l in lines if "ACTION:" in l][0]
            obs = execute_tool(action_line)
            print(f"{BLUE}OBSERVATION:{RESET} {obs[:200]}...")
            log_content += f"OBSERVATION: {obs}\n"
            history.append({"role": "assistant", "content": resp})
            history.append({"role": "user", "content": f"OBSERVATION: {obs}"})
        else: break
    
    with open(LOG_FILE, "w") as f:
        f.write(log_content)
    print(f"\n{BOLD}Tactical log saved to {LOG_FILE}{RESET}")

def main():
    parser = argparse.ArgumentParser(description="Diddy: JIPOE Autonomous Agent")
    subparsers = parser.add_subparsers(dest="command")
    
    jipoe_parser = subparsers.add_parser("jipoe")
    jipoe_parser.add_argument("mission", help="The goal of the mission")
    
    exec_parser = subparsers.add_parser("execute")
    exec_parser.add_argument("--coa", type=int, default=1, help="Which COA to execute (1 or 2)")
    
    args = parser.parse_args()
    if args.command == "jipoe": cmd_jipoe(args.mission)
    elif args.command == "execute": cmd_execute(args.coa)
    else: parser.print_help()

if __name__ == "__main__": main()
