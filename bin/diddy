#!/usr/bin/env python3
import json
import subprocess
import sys
import os
import re
import argparse

OLLAMA_URL = "http://100.81.194.15:30068/api/chat"
PROXY = "127.0.0.1:1055"
PLANNER_MODEL = "llama3.2:3b"
EXECUTOR_MODEL = "qwen2.5-coder:7b"

# Network Hardware
PVE_IP = "100.70.69.28"
NAS_IP = "100.81.194.15"

# HARD VRAM LIMITS (RTX 3060 Ti - 8GB)
MAX_CONTEXT_TOKENS = 4096

# Files
PLAN_FILE = "MISSION_PLAN.md"
LOG_FILE = "MISSION_LOG.md"

# Colors
BLUE = "\033[94m"
GREEN = "\033[92m"
YELLOW = "\033[93m"
RED = "\033[91m"
CYAN = "\033[96m"
BOLD = "\033[1m"
RESET = "\033[0m"

def get_env_context():
    import platform
    return f"OS: {platform.system()} | Host: {platform.node()} | CWD: {os.getcwd()}"

def ask_ollama(model, system, prompt):
    data = json.dumps({
        "model": model,
        "messages": [
            {"role": "system", "content": f"{get_env_context()} {system}"},
            {"role": "user", "content": prompt}
        ],
        "stream": False,
        "keep_alive": 0,
        "options": {"num_ctx": MAX_CONTEXT_TOKENS}
    })
    cmd = ["curl", "-s", "--socks5-hostname", PROXY, "-H", "Content-Type: application/json", "-d", data, OLLAMA_URL]
    result = subprocess.run(cmd, capture_output=True, text=True)
    try:
        return json.loads(result.stdout).get("message", {}).get("content", "")
    except:
        return f"Error: {result.stdout}"

def execute_tool(action_line):
    match = re.match(r'ACTION:\s*(\w+)\s*"(.*)"', action_line, re.IGNORECASE)
    if not match: return "Error: Invalid action format."
    tool, cmd = match.groups()
    print(f"{BOLD}{BLUE}[Executing {tool}]{RESET} {cmd}")
    
    if tool.lower() == "run_local":
        res = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        return (res.stdout + res.stderr).strip()
    elif tool.lower() == "ssh_pve":
        ssh = ["ssh", "-o", f"ProxyCommand=ncat --proxy {PROXY} --proxy-type socks5 %h %p", "-o", "StrictHostKeyChecking=no", f"root@{PVE_IP}", cmd]
        res = subprocess.run(ssh, capture_output=True, text=True)
        return (res.stdout + res.stderr).strip()
    elif tool.lower() == "ssh_truenas":
        ssh = ["sshpass", "-p", "crispypond211", "ssh", "-o", f"ProxyCommand=ncat --proxy {PROXY} --proxy-type socks5 %h %p", "-o", "StrictHostKeyChecking=no", f"nasuser@{NAS_IP}", cmd]
        res = subprocess.run(ssh, capture_output=True, text=True)
        return (res.stdout + res.stderr).strip()
    return "Unknown tool."

def cmd_plan(mission):
    print(f"{BOLD}{GREEN}📝 PLANNER LANE (IS) ACTIVE{RESET}")
    sys_prompt = "You are a Planner. Create a strict, step-by-step markdown plan to solve the user's mission. Identify which files need to be checked and which hosts (local, PVE, TrueNAS) need to be accessed. Output ONLY the markdown plan."
    plan = ask_ollama(PLANNER_MODEL, sys_prompt, mission)
    with open(PLAN_FILE, "w") as f:
        f.write(plan)
    print(f"\n{BOLD}Plan generated and saved to {PLAN_FILE}{RESET}\n{plan}")

def cmd_act():
    if not os.path.exists(PLAN_FILE):
        print(f"{RED}Error: No {PLAN_FILE} found. Run 'diddy plan' first.{RESET}")
        return
    
    print(f"{BOLD}{YELLOW}🔧 EXECUTOR LANE (CT) ACTIVE{RESET}")
    with open(PLAN_FILE, "r") as f:
        plan = f.read()

    # Simple execution loop
    history = [{"role": "system", "content": f"Execute this plan: {plan}. Use format THOUGHT: reason, ACTION: tool_name \"cmd\". Tools: run_local, ssh_pve, ssh_truenas. Limit 5 steps. End with REPORT: summary."}]
    
    log_content = ""
    for i in range(5):
        data = json.dumps({"model": EXECUTOR_MODEL, "messages": history, "stream": False, "keep_alive": 0})
        cmd = ["curl", "-s", "--socks5-hostname", PROXY, "-H", "Content-Type: application/json", "-d", data, OLLAMA_URL]
        res = subprocess.run(cmd, capture_output=True, text=True)
        resp = json.loads(res.stdout).get("message", {}).get("content", "")
        
        print(f"\n{CYAN}--- Step {i+1} ---{RESET}\n{resp}")
        log_content += f"\nStep {i+1}:\n{resp}\n"
        
        if "REPORT:" in resp: break
        if "ACTION:" in resp:
            action_line = [l for l in resp.split("\n") if "ACTION:" in l][0]
            obs = execute_tool(action_line)
            print(f"{BLUE}RESULT:{RESET} {obs[:200]}...")
            log_content += f"RESULT: {obs}\n"
            history.append({"role": "assistant", "content": resp})
            history.append({"role": "user", "content": f"OBSERVATION: {obs}"})
        else: break
    
    with open(LOG_FILE, "w") as f:
        f.write(log_content)
    print(f"\n{BOLD}Execution log saved to {LOG_FILE}{RESET}")

def cmd_brief():
    if not os.path.exists(LOG_FILE):
        print(f"{RED}Error: No {LOG_FILE} found. Run 'diddy act' first.{RESET}")
        return
    print(f"{BOLD}{GREEN}🎖️  BRIEFING LANE (IS) ACTIVE{RESET}")
    with open(LOG_FILE, "r") as f: log = f.read()
    sys_prompt = "You are a senior analyst. Summarize the raw technical logs into a professional BLUF (Bottom Line Up Front) brief for the CO."
    brief = ask_ollama(PLANNER_MODEL, sys_prompt, log)
    print(f"\n{BOLD}BLUF:{RESET}\n{brief}")

def main():
    parser = argparse.ArgumentParser(description="Diddy: Split-Brain Navy Agent")
    subparsers = parser.add_subparsers(dest="command")
    
    plan_parser = subparsers.add_parser("plan")
    plan_parser.add_argument("mission", help="The goal of the mission")
    
    subparsers.add_parser("act")
    subparsers.add_parser("brief")
    
    args = parser.parse_args()
    if args.command == "plan": cmd_plan(args.mission)
    elif args.command == "act": cmd_act()
    elif args.command == "brief": cmd_brief()
    else: parser.print_help()

if __name__ == "__main__": main()
