#!/usr/bin/env python3
from http.server import BaseHTTPRequestHandler, HTTPServer
import json
import os
import subprocess
import re
import traceback

# CONFIGURATION
OLLAMA_URL = os.environ.get("BRAIN_ROUTER_OLLAMA", "http://100.81.194.15:30068/v1/chat/completions")
PROXY = os.environ.get("BRAIN_ROUTER_PROXY", "")
MODEL = "qwen2.5-coder:7b"

LOG_FILE = "/tmp/router_debug.log"

def debug_log(msg):
    with open(LOG_FILE, "a") as f:
        f.write(f"{msg}\n")

class BrainRouter(BaseHTTPRequestHandler):
    def map_tool(self, name, args):
        """Clean command strings of all shell-breaking artifacts"""
        cmd = name
        if isinstance(args, dict):
            if "command" in args: cmd = args["command"]
            elif "args" in args: cmd = f"{name} {args['args']}"
            elif args: cmd = f"{name} " + " ".join([str(v) for v in args.values()])
        
        # 1. STRIP ALL MARKDOWN AND QUOTE TRASH
        cmd = cmd.strip().strip('`').strip() # Remove backticks
        cmd = cmd.replace('“', '"').replace('”', '"').replace('‘', "'").replace('’', "'")
        cmd = cmd.replace('```bash', '').replace('```sh', '').replace('```', '')
        
        # 2. JSON BLOCK DECAPITATION
        if "{" in cmd and "}" in cmd:
            try:
                potential_json = re.search(r'\{.*\}', cmd, re.DOTALL)
                if potential_json:
                    j_data = json.loads(potential_json.group(0))
                    cmd = j_data.get("command") or j_data.get("args") or cmd
            except: pass

        # 3. SILENT CORRECTIONS
        if "100.x" in cmd: cmd = cmd.replace("100.x", "100.64.0.0/16")
        if "nmap" in cmd.lower() and "-sn" not in cmd.lower():
            cmd = cmd.replace("nmap", "nmap -sn")
        
        # 4. FORCE PROXY & PATHS
        if "nmap" in cmd.lower(): cmd = "/usr/bin/proxychains4 -q /usr/bin/nmap " + cmd.split("nmap")[-1]
        if "ssh" in cmd.lower() and "sshpass" not in cmd.lower(): cmd = "/usr/bin/proxychains4 -q /usr/bin/ssh " + cmd.split("ssh")[-1]
        if "sshpass" in cmd.lower(): cmd = cmd.replace("ssh ", "/usr/bin/proxychains4 -q /usr/bin/ssh ")
            
        final_cmd = cmd.replace('`', '').strip()
        debug_log(f"🛠️  CLEANED CMD: {final_cmd}")
        return "bash", {"command": final_cmd}

    def translate_request(self, ant_req):
        god_mode = (
            "SYSTEM OVERRIDE: YOU ARE A TERMINAL. OUTPUT ONLY THE RAW BASH COMMAND STRING. "
            "DO NOT USE BACKTICKS. DO NOT USE JSON. DO NOT USE MARKDOWN. "
            "JUST THE COMMAND. ACTION ONLY."
        )
        sys_p = god_mode + "\n\n" + ant_req.get("system", "")
        messages = [{"role": "system", "content": sys_p}]
        for m in ant_req.get("messages", []):
            role, content = m["role"], m.get("content", "")
            if isinstance(content, list):
                text = "".join([b.get("text", "") for b in content if b.get("type") == "text"])
                for b in content:
                    if b.get("type") == "tool_result":
                        messages.append({"role": "tool", "tool_call_id": b["tool_use_id"], "content": str(b.get("content", ""))})
                if text: messages.append({"role": role, "content": text})
            else:
                messages.append({"role": role, "content": content})
        return messages

    def translate_to_anthropic(self, raw, model):
        try:
            o = json.loads(raw)
            choice = o["choices"][0]
            msg = choice["message"]
            content = (msg.get("content") or "").strip()
            blocks, tools = [], []
            
            if "tool_calls" in msg:
                for tc in msg["tool_calls"]:
                    f = tc.get("function", {})
                    t_n, t_a = self.map_tool(f.get("name"), json.loads(f.get("arguments", "{}")))
                    tools.append({"type": "tool_use", "id": tc.get("id", "c123"), "name": t_n, "input": t_a})
            
            # Fallback extraction
            if not tools and len(content) > 2:
                # If content looks like a command, force it
                t_n, t_a = self.map_tool("bash", {"command": content})
                tools.append({"type": "tool_use", "id": "forced", "name": t_n, "input": t_a})
                content = ""

            if content or not tools: blocks.append({"type": "text", "text": content or "Executing..."})
            blocks.extend(tools)
            return json.dumps({
                "id": f"msg_local_{o.get('id', '123')}", "type": "message", "role": "assistant", "model": "claude-3-5-sonnet-20241022",
                "content": blocks, "stop_reason": "tool_use" if tools else "end_turn",
                "usage": {"input_tokens": o.get("usage", {}).get("prompt_tokens", 0), "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "output_tokens": o.get("usage", {}).get("completion_tokens", 0)}
            })
        except: return json.dumps({"id": "err", "type": "message", "role": "assistant", "model": "error", "content": [{"type": "text", "text": "Format Error"}], "stop_reason": "end_turn", "usage": {"input_tokens": 0, "output_tokens": 0}})

    def do_POST(self):
        try:
            cl = int(self.headers['Content-Length'])
            req = json.loads(self.rfile.read(cl).decode('utf-8'))
            if "tools" in req: req["tools"] = [t for t in req["tools"] if t["name"] == "bash"]
            payload = {"model": MODEL, "messages": self.translate_request(req), "stream": False, "temperature": 0.0}
            res = subprocess.run(["curl", "-s", "-X", "POST", "-H", "Content-Type: application/json", "-d", json.dumps(payload), OLLAMA_URL], capture_output=True, text=True)
            encoded = self.translate_to_anthropic(res.stdout, MODEL).encode('utf-8')
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.send_header('Content-Length', str(len(encoded)))
            self.end_headers()
            self.wfile.write(encoded)
        except Exception as e:
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.end_headers()
            self.wfile.write(json.dumps({"id": "err", "type": "message", "content": [{"type": "text", "text": str(e)}], "usage": {"input_tokens": 0, "output_tokens": 0}}).encode('utf-8'))

if __name__ == "__main__":
    print(f"🚀 SHELL-SAFE ROUTER ACTIVE ON PORT 11435")
    HTTPServer(('', 11435), BrainRouter).serve_forever()
